<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Keep in step with the release tag (vX.Y.Z); shows as the .exe's file/product version on Windows. -->
    <Version>0.2.0</Version>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\gradebook.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--
      PublishAot is intentionally NOT set unconditionally here: it alters even a plain dotnet build's
      output layout and broke the Avalonia XAML compiler step during development. Pass it at publish
      time instead, e.g. dotnet publish -r linux-x64 -p:PublishAot=true (see the project plan for the
      full publish commands for each platform).
    -->
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <!-- Only apply self-contained when an explicit RID is targeted (i.e. at publish time), not for plain `dotnet build`. -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!--
    SkiaSharp/HarfBuzzSharp ship ~100 MB of native debug symbols (.pdb) that would otherwise be copied
    next to the published .exe. They're not needed to run the app, so keep them out of publish output.
  -->
  <Target Name="ExcludeDebugSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\GradeBook.Core\GradeBook.Core.csproj" />
    <ProjectReference Include="..\GradeBook.Reports.Pdf\GradeBook.Reports.Pdf.csproj" />
  </ItemGroup>
</Project>
