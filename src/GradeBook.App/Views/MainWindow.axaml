<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GradeBook.App.ViewModels"
        xmlns:views="using:GradeBook.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="GradeBook.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="GradeBook"
        Width="1100" Height="700">

    <TabControl SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem Header="Classes &amp; Students">
            <views:ClassesAndStudentsView DataContext="{Binding ClassesAndStudents}" />
        </TabItem>
        <TabItem Header="Gradebook">
            <views:GradebookView DataContext="{Binding Gradebook}" />
        </TabItem>
        <TabItem Header="Reports">
            <views:ReportsView DataContext="{Binding Reports}" />
        </TabItem>
    </TabControl>
</Window>
