<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GradeBook.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="GradeBook.App.Views.AttendanceView"
             x:DataType="vm:AttendanceViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16" RowSpacing="10">

        <TextBlock Grid.Row="0" Text="Attendance" FontWeight="Bold" FontSize="16" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Quarter:" VerticalAlignment="Center" />
            <ComboBox Width="100" ItemsSource="{Binding Quarters, Mode=OneTime}" SelectedItem="{Binding SelectedQuarter}" />
            <TextBlock Text="Totals for the quarter. Changes save automatically." Foreground="Gray"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#80808080" BorderThickness="0,0,0,2" Padding="8,0,8,6">
            <Grid ColumnDefinitions="200,150,150" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="Student" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="Absent" FontWeight="Bold" />
                <TextBlock Grid.Column="2" Text="Tardy" FontWeight="Bold" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AttendanceRowViewModel">
                        <!-- A divider line and generous padding per student, so a count can't be typed on the wrong row. -->
                        <Border BorderBrush="#60808080" BorderThickness="0,0,0,1" Padding="8,10">
                            <Grid ColumnDefinitions="200,150,150" ColumnSpacing="12">
                                <TextBlock Grid.Column="0" Text="{Binding StudentName}" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding Absences}" Minimum="0" Increment="1" FormatString="0" />
                                <NumericUpDown Grid.Column="2" Value="{Binding Tardies}" Minimum="0" Increment="1" FormatString="0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
