<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GradeBook.App.Views.EditAssignmentDialog"
        Width="380" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Edit Assignment">

    <StackPanel Margin="20" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Name:" Width="60" VerticalAlignment="Center" />
            <TextBox Name="NameBox" Width="240" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Points:" Width="60" VerticalAlignment="Center" />
            <TextBox Name="PointsBox" Width="240" />
        </StackPanel>

        <TextBlock Name="ErrorText" Foreground="Red" TextWrapping="Wrap" IsVisible="False" />

        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <Button Grid.Column="0" Name="DeleteButton" Content="Delete Lesson" />
            <Button Grid.Column="2" Name="CancelButton" Content="Cancel" Margin="0,0,8,0" />
            <Button Grid.Column="3" Name="SaveButton" Content="Save" />
        </Grid>
    </StackPanel>
</Window>
